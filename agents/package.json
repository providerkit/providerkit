{
  "name": "@providerkit/agents",
  "version": "0.1.0",
  "description": "An experimental, provider-independent agent loop with tools and resumable checkpoints.",
  "type": "module",
  "license": "MIT",
  "author": "Gustavo Salomé",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runs": {
      "types": "./dist/runs.d.ts",
      "default": "./dist/runs.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "examples",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p test",
    "lint": "oxlint -c ../.oxlintrc.json src test examples",
    "test": "vitest run",
    "sync:docs": "cp ../LICENSE .",
    "prepublishOnly": "bun run lint && bun run build && bun run typecheck && bun run sync:docs",
    "release": "bun publish --access public"
  },
  "peerDependencies": {
    "@providerkit/core": "^0.30.0",
    "@gusnips/server": "^0.19.0 || ^0.20.0",
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "peerDependenciesMeta": {
    "@gusnips/server": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@gusnips/server": "^0.19.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@providerkit/core": "workspace:*",
    "@types/pg": "^8.15.0",
    "pg": "^8.16.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/providerkit/providerkit.git",
    "directory": "agents"
  }
}
