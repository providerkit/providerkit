{
  // Typechecks the scripts, and emits nothing. They run under bun and read
  // `process`, so they get Node's types; src never does (see ../tsconfig.json).
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "types": ["node"]
  },
  "include": ["./**/*", "../src/**/*"],
  "exclude": []
}
