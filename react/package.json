{
  "name": "@providerkit/react",
  "version": "0.1.0",
  "description": "React hooks and components for chat and agent runs. Bring your own transport and styles.",
  "type": "module",
  "license": "MIT",
  "author": "Gustavo Salomé",
  "exports": {
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./agents": {
      "types": "./dist/agents.d.ts",
      "default": "./dist/agents.js"
    }
  },
  "files": [
    "dist",
    "src",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p test",
    "lint": "oxlint -c ../.oxlintrc.json src test",
    "test": "vitest run",
    "sync:docs": "cp ../LICENSE .",
    "prepublishOnly": "bun run lint && bun run build && bun run typecheck && bun run sync:docs",
    "release": "bun publish --access public"
  },
  "peerDependencies": {
    "@providerkit/agents": "^0.2.0",
    "@providerkit/core": "^0.30.0",
    "react": "^19"
  },
  "peerDependenciesMeta": {
    "@providerkit/agents": {
      "optional": true
    },
    "@providerkit/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@providerkit/agents": "workspace:*",
    "@providerkit/core": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "happy-dom": "^20.14.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/providerkit/providerkit.git",
    "directory": "react"
  }
}
