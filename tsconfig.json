{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    // No "types" and no DOM-only lib: the package must compile against the
    // WHATWG globals every target already has (fetch, AbortSignal, ReadableStream)
    // without pulling in @types/node — that is what keeps it MV3-safe.
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
