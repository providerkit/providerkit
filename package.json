{
  "name": "providerkit-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.2"
  },
  "workspaces": [
    "core",
    "site"
  ],
  "scripts": {
    "build": "bun run --filter @providerkit/core build",
    "test": "bun run --filter @providerkit/core test",
    "typecheck": "bun run build && bun run --filter '*' typecheck",
    "lint": "oxlint core/src core/test core/scripts site/src brand",
    "format": "oxfmt",
    "dev:site": "bun run build && bun run --filter providerkit-site dev",
    "build:site": "bun run build && bun run --filter providerkit-site build",
    "brand:assets": "bun run brand/generate.ts",
    "format:check": "oxfmt --check",
    "release": "bun run --filter @providerkit/core release",
    "release:patch": "bun run --filter @providerkit/core release:patch",
    "release:minor": "bun run --filter @providerkit/core release:minor",
    "release:major": "bun run --filter @providerkit/core release:major",
    "release:alpha": "bun run --filter @providerkit/core release:alpha"
  },
  "devDependencies": {
    "@gusnips/oxlint": "^0.2.2",
    "@resvg/resvg-js": "^2.6.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0"
  }
}
