{
  "name": "providerkit-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "core",
    "site"
  ],
  "scripts": {
    "build": "bun run --filter @providerkit/core build",
    "test": "bun run --filter @providerkit/core test",
    "typecheck": "bun run build && bun run --filter '*' typecheck",
    "lint": "eslint core/src core/test site/src brand",
    "format": "prettier --write .",
    "dev:site": "bun run build && bun run --filter providerkit-site dev",
    "build:site": "bun run build && bun run --filter providerkit-site build",
    "brand:assets": "bun run brand/generate.ts",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@resvg/resvg-js": "^2.6.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.18.2"
  }
}
