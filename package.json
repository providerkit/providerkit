{
  "name": "providerkit-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "core",
    "site"
  ],
  "scripts": {
    "build": "bun run --filter providerkit build",
    "test": "bun run --filter providerkit test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter '*' lint",
    "format": "prettier --write .",
    "dev:site": "bun run --filter providerkit-site dev",
    "build:site": "bun run --filter providerkit-site build"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  }
}
