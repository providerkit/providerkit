{
  "name": "@providerkit/native",
  "version": "0.1.0",
  "description": "Chat on React Native: unstyled components, streaming Markdown and a transport that uses your app's stream reader.",
  "type": "module",
  "license": "MIT",
  "author": "Gustavo Salomé",
  "homepage": "https://providerkit.dev",
  "bugs": {
    "url": "https://github.com/providerkit/providerkit/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "default": "./dist/markdown.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p test && tsc -p scripts",
    "lint": "oxlint -c ../.oxlintrc.json src test scripts",
    "test": "vitest run",
    "check:babel": "bun scripts/check-babel.ts",
    "check:hermes": "node scripts/check-hermes.ts",
    "sync:docs": "cp ../LICENSE .",
    "prepublishOnly": "bun run lint && bun run build && bun run typecheck && bun run check:babel && bun run check:hermes && bun run sync:docs",
    "release": "bun publish --access public"
  },
  "peerDependencies": {
    "@providerkit/react": "^0.2.0",
    "react": "^19",
    "react-native": ">=0.86"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.25.0",
    "@providerkit/react": "workspace:*",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "happy-dom": "^20.14.5",
    "hermes-compiler": "250829098.0.16",
    "nativewind": "5.0.0-preview.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-native": "0.86.2",
    "react-native-css": "3.0.7",
    "react-native-worklets": "0.10.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/providerkit/providerkit.git",
    "directory": "native"
  }
}
