{
  "name": "@providerkit/agents",
  "version": "0.1.0",
  "description": "An experimental, provider-independent agent loop with tools and resumable checkpoints.",
  "type": "module",
  "license": "MIT",
  "author": "Gustavo Salomé",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p test",
    "lint": "oxlint -c ../.oxlintrc.json src test",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@providerkit/core": "^0.30.0"
  },
  "devDependencies": {
    "@providerkit/core": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^4.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/providerkit/providerkit.git",
    "directory": "agents"
  }
}
