{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@gusnips/oxlint/react.json"],
  "plugins": [],
  "jsPlugins": [{ "name": "react-hooks-js", "specifier": "@gusnips/oxlint/react-hooks" }],
  "ignorePatterns": ["site/.astro/**", "site/src/content/docs/reference/**"],
  "rules": {
    "react/unsupported-syntax": "warn",
    "react-hooks-js/purity": "off",
    "react-hooks-js/config": "off",
    "react-hooks-js/gating": "off"
  },
  "overrides": [
    {
      "files": ["agents/src/**/*.ts"],
      "excludeFiles": ["agents/src/quickjs.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../**/core/**", "@providerkit/core/src/**", "@providerkit/core/dist/**"],
                "message": "Agents use core's public exports, never its private files."
              },
              {
                "group": [
                  "quickjs-emscripten*",
                  "quickjs-emscripten*/**",
                  "@jitl/**",
                  "**/quickjs",
                  "**/quickjs.ts",
                  "**/quickjs.js",
                  "@providerkit/agents/code-mode/quickjs"
                ],
                "message": "Only the optional QuickJS driver imports its engine. Use CodeDriver from code-driver.ts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["agents/src/quickjs.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../**/core/**", "@providerkit/core/src/**", "@providerkit/core/dist/**"],
                "message": "Agents use core's public exports, never its private files."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["react/src/**/*.ts", "react/src/**/*.tsx"],
      "excludeFiles": ["react/src/markdown.tsx", "react/src/ui/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../**/core/**",
                  "../**/agents/**",
                  "@providerkit/core/src/**",
                  "@providerkit/core/dist/**",
                  "@providerkit/agents/src/**",
                  "@providerkit/agents/dist/**"
                ],
                "message": "React uses the public exports of core and agents, never their private files."
              },
              {
                "group": [
                  "react-markdown",
                  "react-markdown/**",
                  "remark-gfm",
                  "remark-gfm/**",
                  "@shadcn/react",
                  "@shadcn/react/**",
                  "**/markdown",
                  "**/markdown.tsx",
                  "**/markdown.js",
                  "**/ui",
                  "**/ui/**"
                ],
                "message": "An optional peer loads only from its own entry: react-markdown and remark-gfm from /markdown, @shadcn/react from /ui. An app that does not import that entry may not have the peer, and its bundle would fail."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["react/src/ui/**/*.ts", "react/src/ui/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../**/core/**",
                  "../**/agents/**",
                  "@providerkit/core/src/**",
                  "@providerkit/core/dist/**",
                  "@providerkit/agents/src/**",
                  "@providerkit/agents/dist/**"
                ],
                "message": "React uses the public exports of core and agents, never their private files."
              },
              {
                "group": [
                  "react-markdown",
                  "react-markdown/**",
                  "remark-gfm",
                  "remark-gfm/**",
                  "**/markdown",
                  "**/markdown.tsx",
                  "**/markdown.js"
                ],
                "message": "An optional peer loads only from its own entry: react-markdown and remark-gfm from /markdown, @shadcn/react from /ui. An app that does not import that entry may not have the peer, and its bundle would fail."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["react/src/markdown.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../**/core/**",
                  "../**/agents/**",
                  "@providerkit/core/src/**",
                  "@providerkit/core/dist/**",
                  "@providerkit/agents/src/**",
                  "@providerkit/agents/dist/**"
                ],
                "message": "React uses the public exports of core and agents, never their private files."
              },
              {
                "group": ["@shadcn/react", "@shadcn/react/**", "**/ui", "**/ui/**"],
                "message": "An optional peer loads only from its own entry: react-markdown and remark-gfm from /markdown, @shadcn/react from /ui. An app that does not import that entry may not have the peer, and its bundle would fail."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["native/src/**/*.ts", "native/src/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../**/react/**",
                  "../**/core/**",
                  "../**/agents/**",
                  "@providerkit/react/src/**",
                  "@providerkit/react/dist/**",
                  "@providerkit/core",
                  "@providerkit/core/**",
                  "@providerkit/agents",
                  "@providerkit/agents/**"
                ],
                "message": "Native uses @providerkit/react's public root entry and /protocol only. It loads nothing from core, and agents cannot run on Hermes."
              },
              {
                "group": [
                  "@providerkit/react/sse",
                  "@providerkit/react/ui",
                  "@providerkit/react/ui/**",
                  "@providerkit/react/markdown",
                  "@providerkit/react/agents",
                  "@providerkit/react/ag-ui",
                  "@providerkit/react/styles.css"
                ],
                "message": "Native imports @providerkit/react's root entry and /protocol only: /sse reads fetch streams React Native lacks, /ui, /markdown and styles.css need the DOM, and /agents and /ag-ui run on the server."
              },
              {
                "group": [
                  "@gusnips/*",
                  "@react-native-async-storage/*",
                  "@react-native-community/netinfo",
                  "react-native-css",
                  "react-native-css/**",
                  "nativewind",
                  "nativewind/**",
                  "tailwindcss",
                  "tailwindcss/**"
                ],
                "message": "The app passes in its storage, its network state and its stream reader, and styles parts with its own classes. providerkit never depends on the kit."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "name": "window",
            "message": "React Native has no DOM. This crashes on a phone."
          },
          {
            "name": "document",
            "message": "React Native has no DOM. This crashes on a phone."
          },
          {
            "name": "location",
            "message": "React Native has no DOM. This crashes on a phone."
          },
          {
            "name": "localStorage",
            "message": "React Native has no Web Storage. Take the app's AsyncStorage instead."
          },
          {
            "name": "sessionStorage",
            "message": "React Native has no Web Storage. Take the app's AsyncStorage instead."
          },
          {
            "name": "EventSource",
            "message": "React Native has no EventSource. Streams come through the app's open function."
          },
          {
            "name": "TextDecoder",
            "message": "Hermes has no TextDecoder."
          },
          {
            "name": "structuredClone",
            "message": "Hermes has no structuredClone."
          }
        ]
      }
    },
    {
      "files": [
        "site/**/*.tsx",
        "react/**/*.ts",
        "react/**/*.tsx",
        "native/**/*.ts",
        "native/**/*.tsx"
      ],
      "rules": {
        "react/purity": "off",
        "react-hooks-js/purity": "error",
        "react-hooks-js/config": "error",
        "react-hooks-js/gating": "error"
      }
    },
    {
      "files": ["core/src/speech*.ts", "core/src/providers/*speech*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/decisions*",
                  "**/zod*",
                  "**/auth/**",
                  "**/*transcription*",
                  "**/embeddings*"
                ],
                "message": "Speech imports the shared modules only, never another capability."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["core/src/transcription*.ts", "core/src/providers/*transcription*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/decisions*",
                  "**/zod*",
                  "**/auth/**",
                  "**/*speech*",
                  "**/embeddings*"
                ],
                "message": "Transcription imports the shared modules only, never another capability."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["core/src/embeddings*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/decisions*",
                  "**/zod*",
                  "**/auth/**",
                  "**/*speech*",
                  "**/*transcription*"
                ],
                "message": "Embeddings import the shared modules only, never another capability."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["core/src/decisions*.ts", "core/src/zod*.ts", "core/src/auth/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/*speech*", "**/*transcription*", "**/embeddings*"],
                "message": "Capabilities import the shared modules only, never each other."
              }
            ]
          }
        ]
      }
    }
  ]
}
