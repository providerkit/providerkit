{
  "name": "@providerkit/react",
  "version": "0.1.1",
  "description": "React hooks and components for chat and agent runs. Bring your own transport and styles.",
  "type": "module",
  "license": "MIT",
  "author": "Gustavo Salomé",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./sse": {
      "types": "./dist/sse.d.ts",
      "default": "./dist/sse.js"
    },
    "./agents": {
      "types": "./dist/agents.d.ts",
      "default": "./dist/agents.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "default": "./dist/markdown.js"
    },
    "./ag-ui": {
      "types": "./dist/ag-ui.d.ts",
      "default": "./dist/ag-ui.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && bun run build:css",
    "build:css": "mkdir -p dist && cat src/styles/base.css $(ls src/styles/*.css | grep -v '/base.css$') > dist/styles.css",
    "typecheck": "tsc --noEmit && tsc -p test && bun run typecheck:example",
    "typecheck:example": "tsc -p examples",
    "lint": "oxlint -c ../.oxlintrc.json src test examples",
    "dev:example": "bun --no-env-file examples/chat/server.ts",
    "example:check": "bun --no-env-file examples/chat/check.ts",
    "test": "vitest run",
    "sync:docs": "cp ../LICENSE .",
    "prepublishOnly": "bun run lint && bun run build && bun run typecheck && bun run sync:docs",
    "release": "bun publish --access public"
  },
  "peerDependencies": {
    "@providerkit/agents": "^0.2.0 || ^0.3.0",
    "@providerkit/core": "^0.33.1",
    "react": "^19"
  },
  "peerDependenciesMeta": {
    "@providerkit/agents": {
      "optional": true
    },
    "@providerkit/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@providerkit/agents": "workspace:*",
    "@providerkit/core": "workspace:*",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "happy-dom": "^20.14.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/providerkit/providerkit.git",
    "directory": "react"
  },
  "dependencies": {
    "@shadcn/react": "^0.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
