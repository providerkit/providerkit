{
  "name": "providerkit",
  "version": "0.1.0",
  "description": "The layer under your agent loop: one seam for every LLM provider, plus the failure handling you only learn in production.",
  "type": "module",
  "license": "MIT",
  "author": "Gustavo Salom\u00e9",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "default": "./dist/zod.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "agent",
    "streaming",
    "sse",
    "retry",
    "tool-calling"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "format": "prettier --write .",
    "sync:docs": "cp ../README.md ../LICENSE .",
    "prepublishOnly": "bun run lint && bun run typecheck && bun run test && bun run build && bun run sync:docs",
    "release": "bun publish",
    "release:patch": "bun pm version patch && bun publish",
    "release:minor": "bun pm version minor && bun publish",
    "release:major": "bun pm version major && bun publish",
    "release:alpha": "bun publish --tag alpha"
  },
  "peerDependencies": {
    "zod": "^4"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.2",
    "vitest": "^4.1.2",
    "zod": "^4.3.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/providerkit/providerkit.git"
  },
  "homepage": "https://providerkit.dev",
  "bugs": {
    "url": "https://github.com/providerkit/providerkit/issues"
  }
}
